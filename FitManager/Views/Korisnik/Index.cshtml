@model IEnumerable<FitManager.Models.Korisnik>

@{
    Layout = null;
    ViewData["Title"] = "Korisnici";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-page">

    <section class="top-section">
        <a href="/Admin/Index" class="back-button">←</a>
        <h1>Korisnici</h1>
    </section>

    <div class="admin-toolbar">
        <a href="/Korisnik/Create" class="admin-btn admin-btn-primary">+ Novi korisnik</a>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Uloga)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.KorisnickoIme)</th>
                    <th>@Html.DisplayNameFor(model => model.Ime)</th>
                    <th>@Html.DisplayNameFor(model => model.Prezime)</th>
                    <th>@Html.DisplayNameFor(model => model.Telefon)</th>
                    <th>@Html.DisplayNameFor(model => model.DatumRodjenja)</th>
                    <th>@Html.DisplayNameFor(model => model.DatumRegistracije)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Uloga)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.KorisnickoIme)</td>
                    <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Prezime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefon)</td>
                    <td>@Html.DisplayFor(modelItem => item.DatumRodjenja)</td>
                    <td>@Html.DisplayFor(modelItem => item.DatumRegistracije)</td>
                    <td class="actions-cell">
                        <a href="/Korisnik/Edit/@item.Id">Edit</a><span class="sep">|</span>
                        <a href="/Korisnik/Details/@item.Id">Details</a><span class="sep">|</span>
                        <a href="/Korisnik/Delete/@item.Id">Delete</a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>

</div>
