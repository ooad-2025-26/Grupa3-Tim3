@{
    Layout = null;
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <title>Home Page</title>

    <link rel="stylesheet" href="/css/home.css" />

</head>

<body>

    <!-- HERO SECTION -->
    <div class="hero-section">

        <!-- NAVBAR -->
        <nav class="navbar">

            <!-- LEFT SIDE -->
            <div class="nav-left">

                <a href="/" class="logo-container">

                    <img src="/images/dumbbell.png"
                         alt="Dumbbell"
                         class="nav-icon" />

                    <span class="logo-text">
                        FitManager
                    </span>

                </a>

            </div>

            <!-- CENTER -->
            <div class="nav-center">

                <a href="/" class="nav-link">Početna</a>

                <a href="/#third" class="nav-link">O nama</a>

                <a href="/#plans-section" class="nav-link">Cijena</a>

                <a href="javascript:void(0)" class="nav-link" onclick="openContactModal()">Kontakt</a>

            </div>

            <!-- RIGHT -->
            <div class="nav-right">
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          method="post">
                        <button type="submit" class="login-button">
                            Odjavi se
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Identity/Account/Login"
                       class="login-button">
                        Prijavi se
                    </a>
                }

                <!-- HAMBURGER -->
                <div class="hamburger-menu">

                    ☰

                </div>

                <!-- DROPDOWN MENU -->
                <div class="dropdown-menu">

                    <a href="/Korisnik/Profil" class="dropdown-item">
                        Moj profil
                    </a>

                    @if (User.IsInRole("CLAN"))
                    {
                        <a href="/Clanarina/MojaClanarina" class="dropdown-item">
                            Moja članarina
                        </a>
                        <a href="/Rezervacija/Index" class="dropdown-item">
                            Rezervacije
                        </a>
                        <a href="/PlanTreninga/Index" class="dropdown-item">
                            Plan treninga
                        </a>
                    }

                    @if (User.IsInRole("TRENER"))
                    {
                        <a href="/Rezervacija/Index" class="dropdown-item">
                            Rezervacije
                        </a>
                        <a href="/PlanTreninga/Index" class="dropdown-item">
                            Plan treninga
                        </a>
                    }

                    @if (User.IsInRole("ADMIN"))
                    {
                        <a href="/Rezervacija/Index" class="dropdown-item">
                            Rezervacije
                        </a>
                        <a href="/PlanTreninga/Index" class="dropdown-item">
                            Plan treninga
                        </a>
                        <a href="/Admin/Index" class="dropdown-item">
                            Admin
                        </a>
                    }

                </div>
            </div>

        </nav>
        <!-- HERO TEXT -->
        <div class="hero-content">

            <h1 class="hero-title">

                Započni svoj
                <span>fitness</span>
                put

                <br>

                treniraj i
                <span>zabavi se</span>

            </h1>

            <p class="hero-description">

                Prati svoj napredak, ostani motivisan i poveži se sa zajednicom
                koja te gura naprijed.

                <br>

                FitManager je mjesto gdje se fitness pretvara u zabavu

            </p>

            <div class="hero-buttons">

                <!-- JOIN BUTTON -->
                @if (!User.Identity.IsAuthenticated)
                {
                    <a href="/Identity/Account/Register"
                       class="join-button">
                        Učlani se
                    </a>
                }
                else if (User.IsInRole("CLAN"))
                {
                    <a href="/Clanarina/MojaClanarina"
                       class="join-button">
                        Učlani se
                    </a>
                }

                <!-- MORE BUTTON -->
                <a href="#about-us"
                   class="more-button">

                    Saznaj više

                </a>

            </div>

        </div>

    </div>

    <!-- SECOND SECTION -->
    <section id="about-us" class="second-section">
        <div class="stats-container">

            <!-- ITEM 1 -->
            <div class="stat-item stat-left">

                <h1 class="stat-number">
                    500+
                </h1>

                <p class="stat-text">
                    Članova
                </p>

            </div>

            <!-- ITEM 2 -->
            <div class="stat-item">

                <h1 class="stat-number">
                    20+
                </h1>

                <p class="stat-text">
                    Trenera
                </p>

            </div>

            <!-- ITEM 3 -->
            <div class="stat-item stat-right">

                <h1 class="stat-number">
                    40+
                </h1>

                <p class="stat-text">
                    Grupa
                </p>

            </div>

        </div>



    </section>

    <!-- THIRD SECTION - O NAMA -->
