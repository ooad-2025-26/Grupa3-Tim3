                        </div>
                        <div class="trainer-stat-item">
                            <strong>500+</strong>
                            <span>Klijenata</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>4.9</strong>
                            <span>Ocjena</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TRENER 2 -->
            <div class="trainer-card-modern">
                <div class="trainer-img-wrapper">
                    <img src="/images/trainer2.jpg" alt="Edin Hamidovic" class="trainer-img" />
                    <div class="trainer-socials">
                        <a href="#" class="social-circle">in</a>
                        <a href="#" class="social-circle">fb</a>
                        <a href="#" class="social-circle">ig</a>
                    </div>
                </div>
                <div class="trainer-info">
                    <h3>Edin Hamidović</h3>
