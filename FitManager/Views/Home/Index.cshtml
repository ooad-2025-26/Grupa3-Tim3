                        • Pristup parkingu tokom svakog
                        dolaska na trening
                    </p>

                    <p class="plan-feature">
                        • Imate pristup sauni i bazenu.
                    </p>
                </div>
            </div>

            <!-- CARD 4 -->
            <div class="plan-card">
                <!-- TITLE -->
                <h2 class="plan-title">
                    GODIŠNJI PLAN
                </h2>

                <!-- PRICE -->
                <h1 class="plan-price">
                    800KM
                </h1>

                <!-- LINE -->
                <div class="plan-line"></div>

                <!-- FEATURES -->
                <div class="plan-features">

                    <p class="plan-feature">
                        • Imate 24 satni pristup teretani
                        svaki dan u sedmici.
                    </p>

                    <p class="plan-feature">
                        • Pristup parkingu tokom svakog
                        dolaska na trening
                    </p>

                    <p class="plan-feature">
                        • Imate pristup sauni i bazenu.
                    </p>
                </div>
            </div>

        </div>

        <!-- REGISTRACIJA DUGME -->
        <div class="plans-button-container">

            
            @if (!User.Identity.IsAuthenticated)
            {
                <a href="/Identity/Account/Register"
                   class="plans-join-button">
                    Učlani se
                </a>
            }
            else if (User.IsInRole("CLAN"))
            {
                <a href="/Clanarina/MojaClanarina"
                   class="plans-join-button">
                    Učlani se
                </a>
            }

        </div>

    </section>


    <!-- FOOTER -->

    <footer class="footer-section">
        <!-- FOOTER CONTENT -->
        <div class="footer-content">

            <!-- LOGO -->
            <a href="/" class="footer-logo">

                <img src="/images/dumbbell.png"
                     alt="Logo"
                     class="footer-icon" />

                <span class="footer-text">
                    FitManager
                </span>
        </a>
            

            <!-- LINE -->
            <div class="footer-line"></div>

            <!-- SOCIALS -->
            <div class="footer-socials">

                <img src="/images/youtube.png"
                     alt="Youtube"
                     class="social-icon" />

                <img src="/images/twitter.png"
                     alt="X"
                     class="social-icon" />

                <span class="follow-text">
                    Follow us
                </span>

                <img src="/images/instagram.png"
                     alt="Instagram"
                     class="social-icon" />

                <img src="/images/facebook.png"
                     alt="Facebook"
                     class="social-icon" />

            </div>

        </div>

    </footer>


    <script>

            const hamburger =
                document.querySelector('.hamburger-menu');

            const dropdown =
                document.querySelector('.dropdown-menu');

            hamburger.addEventListener('click', () => {

                if (dropdown.style.display === 'flex') {

                    dropdown.style.display = 'none';

                }

                else {

                    dropdown.style.display = 'flex';

                }

            });


                   

                    

            const slider =
                document.querySelector('.trainer-slider');

            const arrows =
                document.querySelectorAll('.slider-arrow');

            const totalSlides =
                document.querySelectorAll('.trainer-card').length;

            let currentSlide = 0;

            const cardWidth = 315;

            // RIGHT ARROW
            arrows[1].addEventListener('click', () => {

                currentSlide++;

                // LOOP
                if (currentSlide > totalSlides - 2) {

                    currentSlide = 0;

                }

                slider.style.transform =
                    `translateX(-${currentSlide * cardWidth}px)`;

            });

            // LEFT ARROW
            arrows[0].addEventListener('click', () => {

                currentSlide--;

                // LOOP BACK
                if (currentSlide < 0) {

                    currentSlide = totalSlides - 2;

                }

                slider.style.transform =
                    `translateX(-${currentSlide * cardWidth}px)`;

            });

                    
            function openContactModal() {
                document.getElementById("contactModal").style.display = "flex";
            }

            function closeContactModal() {
                document.getElementById("contactModal").style.display = "none";
            }
    
    
    </script>

    <div id="contactModal" class="modal-overlay">
        <div class="contact-modal">
            <button class="modal-close" onclick="closeContactModal()">×</button>

            <h2>Kontakt</h2>

            <p><strong>Email:</strong> fitmanager@gmail.com</p>
            <p><strong>Telefon:</strong> +387 61 123 456</p>
            <p><strong>Lokacija:</strong> Sarajevo, BiH</p>
            <p><strong>Radno vrijeme:</strong> 08:00 - 22:00</p>
        </div>
    </div>
</body>

</html>