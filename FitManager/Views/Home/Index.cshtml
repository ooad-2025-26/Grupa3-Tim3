                    <p class="trainer-bio">Stručnjak za kondicijsku pripremu, kardio treninge i transformaciju tijela.</p>
                    <div class="trainer-stats-row">
                        <div class="trainer-stat-item">
                            <strong>12+</strong>
                            <span>Godina</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>350+</strong>
                            <span>Klijenata</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>4.8</strong>
                            <span>Ocjena</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TRENER 3 -->
            <div class="trainer-card-modern">
                <div class="trainer-img-wrapper">
                    <img src="/images/trainer1.jpg" alt="Ahmed Delic" class="trainer-img" />
                    <div class="trainer-socials">
                        <a href="#" class="social-circle">in</a>
                        <a href="#" class="social-circle">fb</a>
                        <a href="#" class="social-circle">ig</a>
                    </div>
                </div>
                <div class="trainer-info">
                    <h3>Ahmed Delić</h3>
                    <span class="trainer-badge trainer-badge-blue">Personalni trener</span>
                    <p class="trainer-bio">Fokus na trening snage, bodybuilding i savjetovanje o ishrani.</p>
                    <div class="trainer-stats-row">
                        <div class="trainer-stat-item">
                            <strong>8+</strong>
                            <span>Godina</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>200+</strong>
                            <span>Klijenata</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>4.7</strong>
                            <span>Ocjena</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TRENER 4 -->
            <div class="trainer-card-modern">
                <div class="trainer-img-wrapper">
                    <img src="/images/trainer2.jpg" alt="Halid Masovic" class="trainer-img" />
                    <div class="trainer-socials">
                        <a href="#" class="social-circle">in</a>
                        <a href="#" class="social-circle">fb</a>
                        <a href="#" class="social-circle">ig</a>
                    </div>
                </div>
                <div class="trainer-info">
                    <h3>Halid Masović</h3>
                    <span class="trainer-badge trainer-badge-purple">Yoga & Pilates</span>
                    <p class="trainer-bio">Certificirani instruktor joge i pilatesa, specijaliziran za fleksibilnost i opuštanje.</p>
                    <div class="trainer-stats-row">
                        <div class="trainer-stat-item">
                            <strong>6+</strong>
                            <span>Godina</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>150+</strong>
                            <span>Klijenata</span>
                        </div>
                        <div class="trainer-stat-item">
                            <strong>4.9</strong>
                            <span>Ocjena</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="about-cta">
            <a href="#plans-section" class="about-cta-btn">Započni svoj put</a>
        </div>

    </section>

    <!-- FOURTH SECTION -->

