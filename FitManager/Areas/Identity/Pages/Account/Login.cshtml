@page
@model LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <link rel="stylesheet" href="/css/login.css" />
</head>

<body>

    <div class="login-container">

        
        <div class="left-side">

            <div class="left-text">

                <h1>
                    Vrijeme je za tvoju
                    <span>transformaciju!</span>
                </h1>

            </div>

        </div>

        <!-- DESNA STRANA -->
        <div class="right-side">
            
            <a href="/">

                <img src="/images/logo.jpg"
                     alt="Logo"
                     class="logo" />

            </a>
            <h2 class="welcome-text">
                Dobro Došli u FitManager
            </h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="input-box">
                    <img src="/images/user.png" alt="User Icon" class="input-icon">

                    <input asp-for="Input.Email"
                           type="text"
                           placeholder="Unesite e-mail ili korisničko ime" />
                </div>

                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <div class="input-box">
                    <img src="/images/lock.png"
                         alt="Lock Icon"
                         class="input-icon">

                    <div class="password-wrapper">
                        <input asp-for="Input.Password"
                               type="password"
                               class="pwd-input"
                               placeholder="Unesite vašu šifru" />
                        <button type="button" class="pwd-toggle" aria-label="Show password">Prikaži</button>
                    </div>
                </div>


                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <div class="button-group">

                    <button type="submit" class="login-button">
                        Prijavi se
                    </button>

                    <a href="/Identity/Account/Register"
                       class="register-button">
                        Registruj se
                    </a>

                </div>



            </form>
           
            
        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.pwd-toggle').forEach(btn=>{
            btn.addEventListener('click', function(){
                const wrapper = btn.parentElement;
                const input = wrapper.querySelector('.pwd-input');
                if(!input) return;
                if(input.type === 'password'){ input.type = 'text'; btn.textContent = 'Sakrij'; }
                else { input.type = 'password'; btn.textContent = 'Prikaži'; }
            });
        });
    </script>


</body>

</html>


   
