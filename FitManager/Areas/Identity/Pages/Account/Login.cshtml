@page
@model LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />

    <title>Login</title>

    <link rel="stylesheet" href="/css/login.css" />
</head>

<body>

    <div class="login-container">

        
        <div class="left-side">

            <div class="left-text">

                <h1>
                    Vrijeme je za tvoju
                    <span>transformaciju!</span>
                </h1>

            </div>

        </div>

        <
        <div class="right-side">
            <img src="/images/logo.jpg" alt="FitManager Logo" class="logo" />

            <h2 class="welcome-text">
                Dobro Došli u FitManager
            </h2>
           
            <div class="input-box">

                <img src="/images/user.png" alt="User Icon" class="input-icon">
                <input type="email" placeholder="Unesite vaš e-mail">

            </div>

            <div class="input-box">

                <img src="/images/lock.png"
                     alt="Lock Icon"
                     class="input-icon">

                <input type="password"
                       placeholder="Unesite vašu šifru">

            </div>

            <div class="button-group">

                <button class="login-button">
                    Prijavi se
                </button>

                <button class="register-button">
                    Registruj se
                </button>

            </div>
        </div>

    </div>

</body>

</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}