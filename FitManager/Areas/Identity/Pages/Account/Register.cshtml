@page
@model RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register</title>

    <link rel="stylesheet" href="/css/register.css" />
</head>

<body>
    <div class="top-bar"></div>

    <div class="main-content">

        <!-- LOGO -->
        <div class="logo-container">
            <a href="/">
                <img src="/images/logo.jpg"
                     alt="Logo"
                     class="logo" />
            </a>
        </div>

        <!-- TEKST -->
        <div class="text-container">

            <h1 class="register-title">
                Registracija korisnika
            </h1>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <p class="input-label">
                    Unesite vašu e-mail adresu
                </p>

                <input asp-for="Input.Email"
                       type="email"
                       class="custom-input"
                       placeholder="E-mail adresa" />

                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <p class="input-label">
                    Unesite broj telefona
                </p>

                <input asp-for="Input.Telefon"
                       type="text"
                       inputmode="numeric"
                       pattern="\d{9}"
                       maxlength="9"
                       class="custom-input"
                       placeholder="Broj telefona (9 cifara)" />

                <span asp-validation-for="Input.Telefon" class="text-danger"></span>

                <p class="input-label">
                    Unesite vašu šifru
                </p>

                <div class="password-wrapper">
                    <input asp-for="Input.Password"
                           type="password"
                           class="custom-input pwd-input"
                           placeholder="Unesite vašu šifru" />

                    <button type="button"
                            class="pwd-toggle"
                            aria-label="Show password">
                        Prikaži
                    </button>
                </div>

                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <p class="input-label">
                    Potvrdite vašu šifru
                </p>

                <div class="password-wrapper">
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           class="custom-input pwd-input"
                           placeholder="Potvrdite vašu šifru" />

                    <button type="button"
                            class="pwd-toggle"
                            aria-label="Show confirm password">
                        Prikaži
                    </button>
                </div>

                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                <button type="submit" class="register-button">
                    Registruj se
                </button>
            </form>

        </div>
    </div>

    <div class="bottom-bar"></div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.pwd-toggle').forEach(btn => {
            btn.addEventListener('click', function () {
                const wrapper = btn.parentElement;
                const input = wrapper.querySelector('.pwd-input');

                if (!input) return;

                if (input.type === 'password') {
                    input.type = 'text';
                    btn.textContent = 'Sakrij';
                } else {
                    input.type = 'password';
                    btn.textContent = 'Prikaži';
                }
            });
        });

        const phone = document.querySelector('input[name="Input.Telefon"]');

        if (phone) {
            phone.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '').slice(0, 9);
            });
        }
    </script>
</body>
</html>