@startuml AD01_RegistracijaNovogClana
title Dijagram aktivnosti - Registracija novog člana

|Administrator|
start
:Pokretanje opcije za\nregistraciju novog člana;

|Sistem|
:Prikaz forme za unos\npodataka člana;

|Administrator|
:Unos podataka člana\n(ime, prezime, email,\ntelefon, datum rođenja);
:Potvrda unosa;

|Sistem|
:Validacija unesenih podataka;

if (Podaci validni?) then (Da)
  if (Email već postoji?) then (Ne)
    :Kreiranje profila člana\nsa datumom registracije;
    :Generisanje jedinstvenog\nQR koda;
    :Slanje email-a članu/
    :Prikaz potvrde uspješne\nregistracije sa QR kodom;
  else (Da)
    :Prikaz poruke da član\nsa tim email-om već postoji;
    |Administrator|
    :Unos drugog email-a;
  endif
else (Ne)
  :Prikaz poruke o grešci\nsa opisom problema;
  |Administrator|
  :Ispravka nevalidnih podataka;
endif
stop

@enduml
