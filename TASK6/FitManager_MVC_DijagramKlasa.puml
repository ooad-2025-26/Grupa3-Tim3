@startuml FitManager_MVC_DijagramKlasa
title FitManager MVC dijagram

!pragma layout elk
left to right direction
hide circle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam wrapWidth 160
skinparam nodesep 45
skinparam ranksep 55
skinparam class {
  BackgroundColor #F8FBFF
  BorderColor #315A7D
  ArrowColor #315A7D
  FontName Segoe UI
  FontSize 11
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #A6B5C4
  FontName Segoe UI
}

package "Model" as P_Model {
  class Korisnik {
    +Id: int
    +Uloga: UlogaKorisnika
    +Email: string
    +KorisnickoIme: string
    +Ime: string
    +Prezime: string
    +Telefon: string
    +DatumRodjenja: DateTime
    +DatumRegistracije: DateTime
    +QRKod: QRKod?
    +AzurirajEmail(email: string): void
    +AzurirajProfil(podaci: ProfilClana): void
    +KonfigurisiCijenu(tipClanarine: TipClanarine, cijena: decimal): void
  }

  class ProfilClana <<NotMapped>> {
    +Ime: string
    +Prezime: string
    +Telefon: string
    +DatumRodjenja: DateTime
  }

  class Termin <<NotMapped>> {
    +DatumVrijeme: DateTime
    +Trajanje: int
  }

  class QRKod {
    +Id: int
    +Kod: string
    +DatumGenerisanja: DateTime
    +Aktivan: bool
    +ClanId: int
    +Clan: Korisnik
    +Deaktiviraj(): void
  }

  class TipClanarine {
    +Id: int
    +Naziv: TipClanarineNaziv
    +TrajanjeDana: int
    +Cijena: decimal
    +PromijeniCijenu(cijena: decimal): void
  }

  class Clanarina {
    +Id: int
    +DatumPocetka: DateTime
    +DatumIsteka: DateTime
    +Cijena: decimal
    +Status: StatusClanarine
    +ObavjestenjePoslano: bool
    +ClanId: int
    +Clan: Korisnik
    +TipClanarineId: int
    +TipClanarine: TipClanarine
    +AktivnaNa(datum: DateTime): bool
    +OznaciObavijestena(): void
    +Otkazi(): void
  }

  class GrupniTrening {
    +Id: int
    +Naziv: string
    +Opis: string
    +MaksKapacitet: int
    +SlobodnaMjesta: int
    +DatumVrijeme: DateTime
    +Trajanje: int
    +TipTreninga: TipTreninga
    +TrenerId: int
    +Trener: Korisnik
    +ImaSlobodnihMjesta(): bool
    +RezervisiMjesto(): void
    +OslobodiMjesto(): void
    +PreklapaSeSa(termin: Termin): bool
  }

  class Rezervacija {
    +Id: int
    +ClanId: int
    +Clan: Korisnik
    +GrupniTreningId: int
    +GrupniTrening: GrupniTrening
    +DatumKreiranja: DateTime
    +Status: StatusRezervacije
    +Aktivna(): bool
    +Otkazi(vrijeme: DateTime): void
  }

  class Dolazak {
    +Id: int
    +VrijemeDolaska: DateTime
    +ClanId: int
    +Clan: Korisnik
    +RegistrovanNaDan(datum: DateTime): bool
  }

  class PlanTreninga {
    +Id: int
    +FitnessCilj: FitnessCilj
    +Bmi: decimal
    +BmiKategorija: BmiKategorija
    +Intenzitet: Intenzitet
    +SedmicniPlan: string
    +DatumKreiranja: DateTime
    +ClanId: int
    +Clan: Korisnik
    +AzurirajIntenzitet(intenzitet: Intenzitet): void
  }

  class Izvjestaj {
    +Id: int
    +TipIzvjestaja: TipIzvjestaja
    +DatumOd: DateTime
    +DatumDo: DateTime
    +DatumGenerisan: DateTime
    +Sadrzaj: string
    +AdministratorId: int
    +Administrator: Korisnik
    +PokrivaPeriod(datum: DateTime): bool
  }

  class EmailObavjestenje {
    +Id: int
    +DatumSlanja: DateTime
    +Status: StatusObavjestenja
    +Sadrzaj: string
    +PokusajSlanja: int
    +ClanarinaId: int
    +Clanarina: Clanarina
    +OznaciPoslano(): void
    +OznaciGresku(): void
  }
}

package "Enumeracije" as P_Enum {
  enum UlogaKorisnika {
    CLAN
    TRENER
    ADMINISTRATOR
  }
  enum TipClanarineNaziv {
    MJESECNA
    KVARTALNA
    GODISNJA
  }
  enum StatusClanarine {
    AKTIVNA
    ISTEKLA
    OTKAZANA
  }
  enum StatusRezervacije {
    AKTIVNA
    OTKAZANA
  }
  enum StatusObavjestenja {
    POSLANO
    GRESKA
    NA_CEKANJU
  }
  enum TipTreninga {
    KARDIO
    SNAGA
    JOGA
    PILATES
  }
  enum TipIzvjestaja {
    PRIHODI
    POSJETE
    TRENINZI
  }
  enum FitnessCilj {
    MRSAVLJENJE
    JACANJE
    IZDRZLJIVOST
  }
  enum BmiKategorija {
    POTHRANJEN
    NORMALAN
    PREKOMJERAN
    GOJAZAN
  }
  enum Intenzitet {
    POCETNIK
    SREDNJI
    NAPREDNI
  }
}

package "Data" as P_Data {
  class ApplicationDbContext <<IdentityDbContext>> {
    +Korisnici: DbSet<Korisnik>
    +QRKodovi: DbSet<QRKod>
    +TipoviClanarine: DbSet<TipClanarine>
    +Clanarine: DbSet<Clanarina>
    +GrupniTreninzi: DbSet<GrupniTrening>
    +Rezervacije: DbSet<Rezervacija>
    +Dolasci: DbSet<Dolazak>
    +PlanoviTreninga: DbSet<PlanTreninga>
    +Izvjestaji: DbSet<Izvjestaj>
    +EmailObavjestenja: DbSet<EmailObavjestenje>
    #OnModelCreating(modelBuilder: ModelBuilder): void
  }
}

package "Kontroleri" as P_Controller {

  class ClanoviController {
    +GET /Clanovi: Index()
    +GET /Clanovi/Details/{id}: Details(id)
    +GET /Clanovi/Create: Create()
    +POST /Clanovi/Create: Create(korisnik: Korisnik)
    +GET /Clanovi/Edit/{id}: Edit(id)
    +POST /Clanovi/Edit/{id}: Edit(id, profil: ProfilClana)
    +GET /Clanovi/QRCode/{id}: QRCode(id)
  }

  class ClanarineController {
    +GET /Clanarine: Index()
    +GET /Clanarine/Kupi: Kupi()
    +POST /Clanarine/Kupi: Kupi(clanarina: Clanarina)
    +POST /Clanarine/Otkazi/{id}: Otkazi(id)
    +GET /Clanarine/Tipovi: Tipovi()
    +POST /Clanarine/PromijeniCijenu/{tipId}: PromijeniCijenu(tipId, cijena)
  }

  class GrupniTreninziController {
    +GET /GrupniTreninzi/Raspored: Raspored()
    +GET /GrupniTreninzi/Create: Create()
    +POST /GrupniTreninzi/Create: Create(trening: GrupniTrening)
    +GET /GrupniTreninzi/Edit/{id}: Edit(id)
    +POST /GrupniTreninzi/Edit/{id}: Edit(id, trening: GrupniTrening)
    +POST /GrupniTreninzi/Delete/{id}: Delete(id)
  }

  class RezervacijeController {
    +GET /Rezervacije/Moje: Moje()
    +POST /Rezervacije/Rezervisi/{treningId}: Rezervisi(treningId)
    +POST /Rezervacije/Otkazi/{treningId}: Otkazi(treningId)
  }

  class DolasciController {
    +GET /Dolasci: Index()
    +POST /Dolasci/QR: EvidentirajQR(qrKod)
    +GET /Dolasci/Historija/{korisnikId}: Historija(korisnikId)
  }

  class PlanoviTreningaController {
    +GET /PlanoviTreninga/Preporuka: Preporuka()
    +POST /PlanoviTreninga/Preporuka: Preporuka(plan: PlanTreninga)
    +GET /PlanoviTreninga/Korisnik/{korisnikId}: Korisnik(korisnikId)
  }

  class IzvjestajiController {
    +GET /Izvjestaji: Index()
    +POST /Izvjestaji/Generisi: Generisi(tip, datumOd, datumDo)
  }

  class ObavjestenjaController {
    +POST /Obavjestenja/PosaljiIstekClanarine: PosaljiIstekClanarine()
  }
}

package "Pogledi" as P_View {
  class ClanoviView
  class ClanarineView
  class RasporedTreningaView
  class RezervacijeView
  class DolasciView
  class PlanoviTreningaView
  class IzvjestajiView
}

Korisnik ..> ProfilClana : azurira profil
GrupniTrening ..> Termin : provjera preklapanja

Korisnik "1" *-- "0..1" QRKod : clan posjeduje
Korisnik "1" -- "0..*" Clanarina : clan kupuje
TipClanarine "1" -- "0..*" Clanarina : definise
Korisnik "1" -- "0..*" Rezervacija : clan pravi
GrupniTrening "1" -- "0..*" Rezervacija : prima
Korisnik "1" -- "0..*" GrupniTrening : trener vodi
Korisnik "1" -- "0..*" Dolazak : clan ima
Korisnik "1" -- "0..*" PlanTreninga : clan dobija
Clanarina "1" -- "0..*" EmailObavjestenje : pokrece
Korisnik "1" -- "0..*" Izvjestaj : administrator generise

ApplicationDbContext ..> Korisnik
ApplicationDbContext ..> QRKod
ApplicationDbContext ..> TipClanarine
ApplicationDbContext ..> Clanarina
ApplicationDbContext ..> GrupniTrening
ApplicationDbContext ..> Rezervacija
ApplicationDbContext ..> Dolazak
ApplicationDbContext ..> PlanTreninga
ApplicationDbContext ..> Izvjestaj
ApplicationDbContext ..> EmailObavjestenje

ClanoviController ..> Korisnik
ClanoviController ..> ProfilClana
ClanarineController ..> Clanarina
ClanarineController ..> TipClanarine
GrupniTreninziController ..> GrupniTrening
RezervacijeController ..> Rezervacija
DolasciController ..> Dolazak
PlanoviTreningaController ..> PlanTreninga
IzvjestajiController ..> Izvjestaj
ObavjestenjaController ..> EmailObavjestenje

ClanoviController ..> ApplicationDbContext
ClanarineController ..> ApplicationDbContext
GrupniTreninziController ..> ApplicationDbContext
RezervacijeController ..> ApplicationDbContext
DolasciController ..> ApplicationDbContext
PlanoviTreningaController ..> ApplicationDbContext
IzvjestajiController ..> ApplicationDbContext
ObavjestenjaController ..> ApplicationDbContext

ClanoviController ..> ClanoviView
ClanarineController ..> ClanarineView
GrupniTreninziController ..> RasporedTreningaView
RezervacijeController ..> RezervacijeView
DolasciController ..> DolasciView
PlanoviTreningaController ..> PlanoviTreningaView
IzvjestajiController ..> IzvjestajiView

@enduml
